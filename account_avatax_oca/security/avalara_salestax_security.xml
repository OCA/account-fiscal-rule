<odoo noupdate="1">
    <!-- Restrict AvaTax records to companies enabled for the current user. -->
    <record id="account_salestax_avatax_comp_rule" model="ir.access">
        <field name="name">AvaTax multi-company</field>
        <field name="model_id" ref="model_avalara_salestax" />
        <field name="operation">crud</field>
        <field
            name="domain"
        >['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
