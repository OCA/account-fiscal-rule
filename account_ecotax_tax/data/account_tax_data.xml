<odoo noupdate="1">
    <record id="tax_group_ecotax" model="account.tax.group">
        <field name="name">Eco-participation</field>
        <field name="country_id" ref="base.fr" />
    </record>

    <record id="tax_ecotax" model="account.tax">
        <field name="name">EcoTax</field>
        <field name="type_tax_use">sale</field>
        <field name="amount_type">code</field>
        <field name="is_ecotax" eval="True" />
        <field
            name="formula"
        >quantity and product.fixed_ecotax * quantity or 0.0</field>
        <field name="price_include_override">tax_excluded</field>
        <field name="include_base_amount" eval="True" />
        <field name="sequence" eval="0" />
        <field name="tax_exigibility">on_invoice</field>
        <field name="invoice_label">ECOTAX</field>
        <field name="tax_group_id" ref="tax_group_ecotax" />
        <field name="country_id" ref="base.fr" />
        <field
            name="invoice_repartition_line_ids"
            eval="[
                Command.clear(),
                Command.create({
                    'factor_percent': 100,
                    'repartition_type': 'base',
                }),
                Command.create({
                    'factor_percent': 100,
                    'repartition_type': 'tax',
                }),
            ]"
        />
        <field
            name="refund_repartition_line_ids"
            eval="[
                Command.clear(),
                Command.create({
                    'factor_percent': 100,
                    'repartition_type': 'base',
                }),
                Command.create({
                    'factor_percent': 100,
                    'repartition_type': 'tax',
                }),
            ]"
        />
    </record>
</odoo>
