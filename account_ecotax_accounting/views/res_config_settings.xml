<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_ecotax_res_config_settings" model="ir.ui.view">
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@id='storno']" position="after">
                <h2>Ecotax</h2>
                <div class="row mt16 o_settings_container" id="ecotax">
                    <div class="col-12 col-lg-12 o_setting_box" id="ecotax-settings">
                        <div class="o_setting_left_pane" />
                        <div class="o_setting_right_pane">
                            <div class="row">
                                <label for="ecotax_account_id" class="col-md-5" />
                                <field
                                    name="ecotax_account_id"
                                    options="{'no_create': True, 'no_edit': True, 'no_open': True}"
                                />
                            </div>
                                <label for="ecotax_journal_id" class="col-md-5" />
                                <field
                                name="ecotax_journal_id"
                                options="{'no_create': True, 'no_edit': True, 'no_open': True}"
                            />
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
